# ---- Claude (required) ----
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# ---- Where the shared plan lives (required) ----
# The bot reads and writes tunis-trip/plan.json in this repository through the GitHub API.
# Use a fine-grained personal access token with "Contents: read and write" on this one repository.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=MajidKhalid/test1
GITHUB_BRANCH=main
PLAN_PATH=tunis-trip/plan.json
DATA_PATH=tunis-trip/data.js
SITE_URL=https://majidkhalid.github.io/test1/tunis-trip/

# ---- Channel: Telegram (simplest; works in a group) ----
TELEGRAM_BOT_TOKEN=123456:ABC...
# Optional: only answer in these chat ids (comma-separated). Leave empty to answer anywhere the bot is added.
TELEGRAM_ALLOWED_CHATS=

# ---- Channel: WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_VERIFY_TOKEN=choose-any-secret
# Optional: only answer these numbers (comma-separated, international format without +).
WHATSAPP_ALLOWED_NUMBERS=

# ---- Server ----
PORT=8787
# Shared secret for POST /chat (the generic endpoint used by bridges and for testing).
CHAT_SECRET=choose-any-secret
